// DIY-2 galvo player for a single-particle photophoretic trap display (ESP32 + MCP4922 12-bit dual DAC).
// UNTESTED ON HARDWARE. Review it, and test with the laser OFF (galvos only), before any laser is connected.
//
// Plays PATH_XYI (generated by path_gen.py -> path.h) at SAMPLE_HZ through an MCP4922 (SPI): channel A = X, B = Y.
// Written for the arduino-esp32 core 2.0.x (timerBegin(0,80,true), ledcSetup/ledcAttachPin). Core 3.x renamed these
// (timerBegin(freq), ledcAttach(pin, freq, bits)); port before compiling there.
// Power the MCP4922 from 3.3 V (at VDD = 5 V its logic-high threshold 0.7*VDD = 3.5 V exceeds the ESP32's 3.3 V outputs).
// VREFA/VREFB = 2.5 V from a shunt reference (LM4040-2.5), so the DAC output is 0..2.5 V. It must go through the op-amp
// stage in ../ELECTRONICS.md to the galvo driver's input (typically +-5 V; +-10 V differential on some drivers).
// ILLUM_PWM_PIN: PWM 0..255 for the illumination (RGB) laser or LED, scaled by the path's intensity column.
//
// SAFETY (mandatory):
//  * The TRAP laser's enable must be cut in HARDWARE by the enclosure lid interlock switch (in series with the driver's
//    enable or supply). This firmware is NOT a safety device.
//  * INTERLOCK_PIN reads the same lid switch (closed = safe). If it opens, the firmware stops scanning and switches
//    illumination off. A stalled galvo concentrates the beam: keep the trap laser at the lowest power that holds the
//    particle.
#include <SPI.h>
#include "path.h"          // generated: PATH_N, PATH_XYI[][3]

const int CS_PIN = 5;            // MCP4922 chip select
const int LDAC_PIN = 17;         // latch both channels simultaneously
const int ILLUM_PWM_PIN = 16;    // illumination intensity (PWM)
const int INTERLOCK_PIN = 4;     // lid switch, INPUT_PULLUP, LOW = closed = safe
const uint32_t SAMPLE_HZ = 20000;

hw_timer_t* timer = nullptr;
volatile uint32_t idx = 0;
volatile bool tick = false;

void IRAM_ATTR onTimer() { tick = true; }

inline void dacWrite(uint8_t ch, uint16_t v) {
  // MCP4922 command bits 15..12: A/B select, BUF (0 = unbuffered VREF, full 0..VREF range), GA (1 = 1x), SHDN (1 = active)
  uint16_t word = (ch ? 0xB000 : 0x3000) | (v & 0x0FFF);
  digitalWrite(CS_PIN, LOW);
  SPI.transfer16(word);
  digitalWrite(CS_PIN, HIGH);
}

void setup() {
  pinMode(CS_PIN, OUTPUT); digitalWrite(CS_PIN, HIGH);
  pinMode(LDAC_PIN, OUTPUT); digitalWrite(LDAC_PIN, HIGH);
  pinMode(INTERLOCK_PIN, INPUT_PULLUP);
  ledcAttachPin(ILLUM_PWM_PIN, 0); ledcSetup(0, 40000, 8); ledcWrite(0, 0);
  SPI.begin(); SPI.beginTransaction(SPISettings(20000000, MSBFIRST, SPI_MODE0));
  timer = timerBegin(0, 80, true);                 // 1 MHz tick
  timerAttachInterrupt(timer, &onTimer, true);
  timerAlarmWrite(timer, 1000000 / SAMPLE_HZ, true);
  timerAlarmEnable(timer);
}

void loop() {
  if (!tick) return;
  tick = false;
  if (digitalRead(INTERLOCK_PIN) != LOW) {         // lid open: park at centre, illumination off
    ledcWrite(0, 0);
    dacWrite(0, 2048); dacWrite(1, 2048);
    digitalWrite(LDAC_PIN, LOW); digitalWrite(LDAC_PIN, HIGH);
    return;
  }
  const uint16_t* p = PATH_XYI[idx];
  dacWrite(0, p[0]);
  dacWrite(1, p[1]);
  digitalWrite(LDAC_PIN, LOW); digitalWrite(LDAC_PIN, HIGH);   // update X and Y together
  ledcWrite(0, p[2]);
  idx = (idx + 1) % PATH_N;
}
